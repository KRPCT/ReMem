DATABASE_URL="file:./dev.db"
# NEXTAUTH_URL is OPTIONAL when `trustHost: true` is set in auth.config.ts
# (the default in this project). When set, NextAuth v5 uses it as the
# canonical base URL for OAuth callbacks, signIn/signOut redirects, and
# email links. When unset, NextAuth infers the base URL from the request's
# `Host` header — so the dev server works on any port (3000, 3001, 3002, …)
# and behind reverse proxies (production) without per-environment config.
#
# Uncomment and edit ONLY if you need a fixed canonical URL (e.g. behind
# a CDN that rewrites Host, or for OpenGraph metadata that needs an
# absolute URL that doesn't depend on the request).
# NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL"
UPLOAD_MAX_SIZE_MB=5
NEXT_PUBLIC_APP_NAME="ReMem"
