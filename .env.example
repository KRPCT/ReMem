# ReMem demo (Supabase Postgres + Vercel + Cloudflare)
# Copy to .env.local for local testing; set the same keys in the Vercel
# project's Environment Variables for the deployment.

# === Database: Supabase Postgres ===
# DATABASE_URL = pooled connection (Supabase "Transaction" pooler, PgBouncer,
# port 6543). Used by the app at runtime on serverless. Keep the query string.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = direct connection (port 5432). Used ONLY by `prisma db push`
# and `prisma migrate` (schema changes), never at runtime.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# === Auth (NextAuth v5) ===
# Generate a 32-byte secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_A_32_BYTE_SECRET"

# Canonical public URL of the deployment. Behind Cloudflare -> Vercel you
# MUST set this to your Cloudflare-proxied domain (the Host header Cloudflare
# forwards may differ), so NextAuth builds correct redirect/callback URLs.
NEXTAUTH_URL="https://demo.example.com"

# === App ===
UPLOAD_MAX_SIZE_MB=5
NEXT_PUBLIC_APP_NAME="ReMem"
